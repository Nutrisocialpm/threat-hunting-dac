# Normalize text files
* text=auto

# Keep repository files with LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.kql text eol=lf
*.yaral text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
